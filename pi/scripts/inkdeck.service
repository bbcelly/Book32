# Installed by scripts/install.sh, which fills in the user and folder.
[Unit]
Description=InkDeck for Raspberry Pi
After=network.target pisugar-server.service
Wants=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=/usr/bin/python3 -m inkdeck
Restart=on-failure
RestartSec=10
# Port 80, for the Wi-Fi setup page (the web interface itself is on 5000).
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
